<resources>
 <color name="icon_navy">#092448</color>
 <style name="Theme.DollarLedger" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:statusBarColor">@android:color/transparent</item>
  <item name="android:navigationBarColor">@android:color/transparent</item>
 </style>
 <style name="Theme.DollarLedger.Starting" parent="Theme.SplashScreen">
  <item name="windowSplashScreenBackground">@color/icon_navy</item>
  <item name="windowSplashScreenAnimatedIcon">@drawable/ic_ledger</item>
  <item name="postSplashScreenTheme">@style/Theme.DollarLedger</item>
 </style>
</resources>
